# PostgreSQL接続用サンプル
DB_NAME=airapj
DB_USER=postgres
DB_PASS=yourpassword
DB_HOST=localhost
DB_PORT=5432
# APIサーバーのポート
PORT=4000
# APIサーバーのホスト（開発環境でスマホからアクセスする場合は 0.0.0.0、本番環境では未指定推奨）
# HOST=0.0.0.0
# アップロードファイルの保存先（オプション）
# UPLOADS_DIR=/path/to/uploads
# Google OAuth Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# システム管理者メールアドレス（カンマ区切り）- 最強権限、すべてのWEB機能を利用可能
# ゲームマスターの登録・削除なども行えます
SYSTEM_ADMIN_EMAILS=admin@example.com,boss@example.com
# 管理者向けエンドポイント（アップロード・更新・削除・ゲームマスター管理）の有効/無効
# false または 0 を指定すると管理系APIが404になります（未設定の場合は有効です）
# ADMIN_ENABLED=false
# CORS で許可するオリジン（カンマ区切り）。未設定の場合は全オリジンを許可します
# 本番環境ではフロントエンドのオリジンを指定して絞ることを推奨します
# CORS_ORIGINS=https://example.com
# 注意: ゲームマスターはWEB画面から登録するため、ここでは設定不要です